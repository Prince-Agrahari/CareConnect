# CareConnect environment variables
# Copy this file to backend/.env (API) and fill in real values locally.
# Never commit a real .env file. Leave secret values empty in this example.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=CareConnect
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (required to run the API)
# Example shape: postgresql://USER:PASSWORD@localhost:5432/careconnect
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# JWT (required in production; APP_ENV=production rejects the code default)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

# ---------------------------------------------------------------------------
# Redis / Celery (required for email, calendar sync, and reminder workers)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Booking
# ---------------------------------------------------------------------------
SLOT_HOLD_MINUTES=5

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=60
APPOINTMENT_REMINDER_HOURS=24

# ---------------------------------------------------------------------------
# Gemini (optional; booking and visit notes still save if unset or failing)
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# SendGrid (optional; notification rows stay pending if unset)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Google Calendar OAuth (optional; connect returns 503 if ID/secret unset)
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET must stay empty in this file.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/calendar/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5173/?calendar=connected
GOOGLE_OAUTH_FAILURE_REDIRECT=http://localhost:5173/?calendar=error

# ---------------------------------------------------------------------------
# Frontend (Vite). Copy VITE_API_URL into frontend/.env as well.
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
